# ============================================================================
# p0bot — Lark long-connection doc Q&A bot — EXAMPLE env
# Copy to `.env` on your server and fill in the real secrets (do NOT commit .env).
# Environment variables override the _CFG defaults in main.py.
# ============================================================================

# ---- Lark app credentials ----
APP_ID=cli_xxxxxxxxxxxxxxxx
APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# International Lark → https://open.larksuite.com ; Feishu (China) → https://open.feishu.cn
LARK_HOST=https://open.larksuite.com

# ---- Receive events via persistent connection (long connection / WebSocket) ----
LARK_EVENT_MODE=ws
ENABLE_HTTP=0

# ---- Turn OFF Grafana monitoring (p0bot is a doc Q&A bot) ----
MONITORING_WATCH_ENABLE=0
GRAFANA_SCREENSHOT_ENABLE=0
GRAFANA_PERSISTENT_BROWSER=0
MONITORING_AI_GATE_ENABLE=0

# ---- p0bot doc Q&A ----
P0_DOC_QA_ENABLE=1
P0_WIKI_URL=https://your-org.larksuite.com/wiki/xxxxxxxxxxxxxxxxxxxxxx
# P0_WIKI_NODE_TOKEN=xxxxxxxxxxxxxxxxxxxxxx
P0_WIKI_INCLUDE_CHILDREN=1
P0_WIKI_MAX_NODES=200
P0_ASK_TRIGGER=/ask
P0_RELOAD_TRIGGER=/reload
P0_QA_ANSWER_DM=1
P0_QA_AT_MENTION_ENABLE=1

# ---- Local Ollama / Qwen ----
P0_QA_OLLAMA_URL=http://localhost:11434
P0_QA_MODEL=qwen3.6:35b-a3b
P0_QA_TIMEOUT_SECONDS=180
P0_QA_NUM_CTX=32768
P0_QA_TEMPERATURE=0.2
P0_DOC_MAX_CHARS=24000
P0_DOC_REFRESH_SECONDS=0

# ---- Local contact directory (name,team,phone) folded into every answer, on top of the wiki ----
# Lets p0bot answer "who do I contact for <team>" / "<person>'s phone" from local data even if the
# wiki doesn't list them. Auto-reloads when the file changes (no /reload). 1=on, 0=off.
P0_CONTACTS_ENABLE=1
# CSV path; empty = contacts.csv next to main.py (ships in the repo, deploys via git pull).
P0_CONTACTS_FILE=
# After answering, if the answer names anyone in the directory, append their phone(s). 1=on.
P0_CONTACTS_APPEND_ENABLE=1

# ---- Message reactions (ACK while thinking, DONE when answered) ----
P0_REACT_ENABLE=1
P0_REACT_ACK_EMOJI=OK
P0_REACT_DONE_EMOJI=DONE
P0_REACT_REMOVE_ACK=1

# ---- Answer formatting: render answers as a clean interactive card ----
P0_ANSWER_CARD=1
P0_CARD_TITLE=📖 p0bot
P0_CARD_TEMPLATE=blue
P0_CARD_MAX_CHARS=8000

# ---- Meeting attendance (Mode C): "/meeting <link-or-number>" attendance report ----
# Needs the app's VC "Meeting Management" report permission (enterprise-admin granted).
P0_MEETING_ENABLE=0
P0_MEETING_TRIGGER=/meeting
P0_MEETING_LOOKBACK_HOURS=6
P0_MEETING_MAX_ROWS=200
P0_MEETING_CARD_TEMPLATE=turquoise
# Admin OAuth (the report needs an admin's user token). Register the redirect_uri in the
# app's Security → Redirect URLs; an admin runs /vcauth once, then /vccode <code>.
P0_VC_REDIRECT_URI=http://localhost:5088/oauth/callback
P0_VC_OAUTH_SCOPES=vc:rooms.room.detailinfo:read offline_access contact:contact.base:readonly contact:user.employee_id:readonly minutes:minutes.transcript:export
# REQUIRED for /vcauth //vccode (empty = nobody; * = everyone). Run /vcauth once; the bot replies
# with your open_id. NOTE the stored token is bot-wide, last-writer-wins — with *, whoever ran
# /vcauth last is the identity used by /whotalk and /meeting.
P0_VC_ADMIN_OPEN_IDS=

# ---- Group members: "/members" lists who's in the CHAT GROUP (needs im:chat:readonly + bot in group) ----
P0_MEMBERS_ENABLE=1
P0_MEMBERS_TRIGGER=/members
P0_MEMBERS_CARD_TEMPLATE=blue
P0_MEMBERS_MAX_ROWS=500

# ---- Bot-hosted meeting: /openmeeting (live join/leave + auto-record + recording to host) ----
# Scopes: vc:reserve, vc:meeting:readonly, vc:meeting, vc:record:readonly, contact:contact.base:readonly.
# Subscribe VC events (started/join/leave/ended/recording_ready). Recording must be tenant-enabled.
P0_OPENMEETING_ENABLE=0
P0_OPENMEETING_TRIGGER=/openmeeting
P0_ENDMEETING_TRIGGER=/endmeeting
P0_MEETING_HOST_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
P0_OPENMEETING_ANNOUNCE_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
P0_OPENMEETING_AUTO_RECORD=1
P0_OPENMEETING_TOPIC=p0bot meeting
P0_OPENMEETING_DURATION_HOURS=4
P0_OPENMEETING_ANNOUNCE_JOINS=1
P0_OPENMEETING_ANNOUNCE_LEAVES=1
P0_OPENMEETING_CARD_TEMPLATE=turquoise
P0_OPENMEETING_ALLOWED_OPEN_IDS=

# ---- /whotalk: who-said-what transcript of a recorded meeting ----
# Lark Minutes supplies speaker names + RAW zh/en text; the LOCAL Qwen fixes ASR errors and adds
# English translations (Lark's own translation is not used). Needs tenant Minutes (妙记) enabled
# and scope minutes:minutes.transcript:export (add + PUBLISH a version). For host-owned minutes the
# stored /vcauth admin token is the fallback — keep the scope in P0_VC_OAUTH_SCOPES and re-/vcauth.
# Usage: /whotalk  |  /whotalk <9-digit meeting no / meeting link>  |  /whotalk <minutes link>
P0_WHOTALK_ENABLE=1
P0_WHOTALK_TRIGGER=/whotalk
# Override the built-in cleanup prompt (empty = built-in: fix ASR errors, keep `Name: text`, add EN).
P0_WHOTALK_PROMPT=
P0_WHOTALK_CHUNK_CHARS=9000
P0_WHOTALK_LOOKBACK_HOURS=72

# ---- /deploy (optional) ----
DEPLOY_ENABLE=0
# DEPLOY_SYSTEMD_SERVICE=p0bot
# DEPLOY_ALLOWED_USER_OPEN_ID=ou_your_open_id_here
